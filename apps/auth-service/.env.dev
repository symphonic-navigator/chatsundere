# Auth-service — LOCAL DEVELOPMENT environment.
#
# These values are throwaway DEV secrets, deliberately committed. They are ONLY
# ever loaded on a developer's machine against the loopback-bound dev compose
# (infra/compose.dev.yml). They are NOT used in any deployment — production keys
# live in an uncommitted compose.prod.yml (see infra/compose.prod.yml.example).
# Loaded explicitly by the dev scripts via `bun --env-file=.env.dev`.

NODE_ENV=development
PORT=3100
LOG_LEVEL=debug

# This service's own public URL (JWT audience binding + OPAQUE server identity).
# In dev the client reaches auth directly on loopback with no path prefix.
API_BASE_URL=http://localhost:3100

# Postgres (dev compose).
DATABASE_URL=postgres://chatsundere:dev@localhost:5432/auth_db
TEST_DATABASE_URL=postgres://chatsundere:dev@localhost:5432/auth_db_test

# Redis (dev compose). Shared db 0 with sync-service so the revocation deny-list
# keys are visible to both.
REDIS_URL=redis://localhost:6379/0

# Dev-only signing/HMAC keys (32-byte, base64url). Regenerate with:
#   bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
AUTH_JWT_PRIVATE_KEY=X88YQoNi8zjucZ7-enArjNrAARC-B5mtGjjy60GGbyA

# Persistent dev OPAQUE server setup (bun run generate-opaque-setup). Without
# it every auth-service restart mints a fresh setup and permanently bricks all
# registered dev accounts' passphrase auth. Committed like the other dev keys.
OPAQUE_SERVER_SETUP=HM5yCiQUGvr-6fJ3P-cKcGSvflYRH_TiBewEkCX99vG1YuzHdO6snnDITwQc0XYAl9xiUPx0_-K6xWPOfMkD8JwGlw-kr6X7C9TO7C2slcI-PWfweMAdg24rDulVu5kMJZ4YIUXUB_30nEY35qG5VSCxZsKj9AZ16eTPCkfHUQM
INVITATION_HMAC_KEY=BxCeP8W-SyPGoOKxh1uHE2ha3Q5_rwbDusYB2fKWAmo
REFRESH_TOKEN_HMAC_KEY=7dBNY7hBguhuBkt7P9ecZjkFrANmCQcuk9-yszfPjt4
HMAC_KEY_PENDING_CODES=hhNQ108QzrMVyfwkQMWF2_PsmgtH4V7qHzhSTKmoNHE
DECOY_WRAP_KEY=kuuVkTHZgz2itdoROhEk9O9Ez3WX8nD_FODa3Thn6lQ

# CORS — the user-client Vite dev server runs on :3000; the admin-client dev
# server runs on :5174 (served under /admin/).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174

# Topology advertised by GET /api/v1/config so the client learns the backend URLs
# instead of hard-coding them, and so the proxy/sync/blobs FEATURES light up. The
# env validator mandates https here (a production security invariant). In dev the
# client reaches sync over http via its VITE_SYNC_URL override; the proxy has no
# such override yet — see the dev-testability note in the README. The scheme below
# is only a placeholder that satisfies the validator and drives the feature flags.
PROXY_PUBLIC_URL=https://localhost:8090
SYNC_PUBLIC_URL=https://localhost:3200
# The admin-client must be reached on the SAME ORIGIN as the user-client, or it
# cannot see the account stored in that origin's IndexedDB ("No account on this
# device"). In dev the user-client (:3000) reverse-proxies /admin/* to the
# admin-client's Vite server (:5174) — the same shim Traefik provides in prod —
# so the working URL is :3000/admin, NOT the admin-client's own :5174 origin.
# ADMIN_PUBLIC_URL tolerates loopback http (the client opens it as a real
# navigation, no VITE override).
ADMIN_PUBLIC_URL=http://localhost:3000/admin/
# The dev sync-service has S3_ENDPOINT wired (MinIO), so the "blobs" feature is on.
SYNC_BLOBS_ENABLED=true
