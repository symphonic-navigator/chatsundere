# Auth-service environment

NODE_ENV=development
PORT=3100
LOG_LEVEL=debug

# Public URL of THIS auth-service. Used as the JWT audience binding and as the
# OPAQUE server identity string. Must match the URL clients reach it at.
API_BASE_URL=http://localhost:3100/auth

# Postgres
DATABASE_URL=postgres://chatsundere:dev@localhost:5432/auth_db

# Test database — used by integration tests. MUST be a separate database from
# DATABASE_URL; integration tests truncate this DB on each run.
# The dev compose creates auth_db_test on first boot; the URL below matches.
# Production deployments leave this unset.
TEST_DATABASE_URL=postgres://chatsundere:dev@localhost:5432/auth_db_test

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT signing — Ed25519 raw private key, base64url-encoded (32 bytes seed).
# Generate once with: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
AUTH_JWT_PRIVATE_KEY=

# OPAQUE server setup — the server's long-term OPAQUE key material. Every
# registration record is cryptographically bound to this value, so it MUST be
# set, stay stable across restarts, and be identical on every replica.
# Generate ONCE with: bun run generate-opaque-setup
# WARNING: losing or regenerating this value permanently invalidates every
# registered account's passphrase authentication (passkey unlock survives, but
# passphrase login, step-up, and recovery re-registration do not).
# If left unset, the auth-service refuses to boot (outside tests) rather than
# silently generating a per-process throwaway setup — see
# ALLOW_EPHEMERAL_OPAQUE_SETUP below.
OPAQUE_SERVER_SETUP=

# Escape hatch for THROWAWAY LOCAL RUNS ONLY — lets the auth-service boot
# without OPAQUE_SERVER_SETUP by generating a per-process ephemeral one.
# Every restart then invalidates all registered accounts' passphrase auth, so
# never set this in a real deployment. Leave unset unless you know why you
# need it. Set to '1' to enable.
ALLOW_EPHEMERAL_OPAQUE_SETUP=

# Invitation token HMAC key — for keyed token hashing in the DB.
# Generate once with: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
INVITATION_HMAC_KEY=

# Refresh token HMAC key — for keyed hashing of refresh tokens stored in the DB.
# Generate once with: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
# WARNING: do not rotate this key without flushing the refresh_tokens table first —
# all live refresh tokens are hashed with this key and will become unresolvable after rotation.
REFRESH_TOKEN_HMAC_KEY=

# Pending-codes HMAC key — for keyed hashing of invitation and pairing codes in
# the pending_codes table. Distinct from INVITATION_HMAC_KEY and
# REFRESH_TOKEN_HMAC_KEY for leak-domain isolation per the cross-device-identity
# brief: a bug in one code surface cannot compromise the others.
# Generate once with: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
# WARNING: rotating this key invalidates every active invitation and pairing code.
HMAC_KEY_PENDING_CODES=

# Decoy-wrap HMAC key — derives deterministic, realistic-shaped OPAQUE wrap
# fields (wrapped_mk_opaque / wrap_nonce_opaque) returned for unknown or
# suspended usernames at POST /api/v1/opaque/login/start, so the response
# shape never leaks account existence. Distinct from every other HMAC key
# above for leak-domain isolation. Rotating this key only changes future
# decoy bytes — it never touches real accounts or real wrapped keys.
# Generate once with: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
DECOY_WRAP_KEY=

# CORS — comma-separated allowed origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174

# Public URL of the authenticated CORS proxy — surfaced by GET /api/v1/config so
# the client learns the topology instead of hard-coding it. Absolute https URL.
PROXY_PUBLIC_URL=https://proxy.chatsundere.me

# Public URL of the sync service — surfaced by GET /api/v1/config as syncUrl and
# the "sync" feature. Optional absolute https URL (omit to run auth+proxy only).
SYNC_PUBLIC_URL=https://sync.chatsundere.me

# Public URL of the admin-client, advertised via GET /api/v1/config so the
# user-client can offer admins an "Admin" launcher. https (or http on a loopback
# host for local dev). Leave unset if you do not deploy the admin-client.
# IMPORTANT: serve the admin-client on the SAME ORIGIN as the user-client (e.g.
# https://app.example/admin), routed there by your reverse proxy. It shares the
# account stored in that origin's IndexedDB; a different origin/subdomain cannot
# see it and shows "No account on this device".
ADMIN_PUBLIC_URL=https://app.chatsundere.example/admin/

# Mirrors the sync-service's S3 blob backend for the /api/v1/config "blobs"
# feature. Set to 'true' ONLY when the sync-service has S3_ENDPOINT configured
# (a manual pairing — see DEPLOYMENT ch.4). Ignored unless SYNC_PUBLIC_URL is set.
SYNC_BLOBS_ENABLED=false

# Number of trusted reverse-proxy hops in front of this service. The client IP
# used for every per-IP rate limit (login/passkey/recovery start, /join, step-up)
# is read this many positions from the RIGHT of X-Forwarded-For — the address the
# trusted front proxy actually observed — so a client cannot spoof its way past a
# per-IP limit by setting X-Forwarded-For itself. Mirrors proxy-service and
# sync-service. Default 1: the shipped deployment fronts auth with a single
# Traefik hop terminating TLS. If you expose auth DIRECTLY (no fronting proxy),
# set this to 0 so only the real socket peer is trusted — leaving it at 1 there
# would trust a client-set X-Forwarded-For.
TRUST_PROXY_HOPS=1
