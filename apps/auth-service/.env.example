# Auth-service environment

NODE_ENV=development
PORT=3100
LOG_LEVEL=debug

# Public URL of THIS auth-service. Used as the JWT audience binding and as the
# OPAQUE server identity string. Must match the URL clients reach it at.
API_BASE_URL=http://localhost:3100/auth

# Postgres
DATABASE_URL=postgres://chatsundere:dev@localhost:5432/auth_db

# Test database — used by integration tests. MUST be a separate database from
# DATABASE_URL; integration tests truncate this DB on each run.
# The dev compose creates auth_db_test on first boot; the URL below matches.
# Production deployments leave this unset.
TEST_DATABASE_URL=postgres://chatsundere:dev@localhost:5432/auth_db_test

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT signing — Ed25519 raw private key, base64url-encoded (32 bytes seed).
# Generate once with: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
AUTH_JWT_PRIVATE_KEY=

# Invitation token HMAC key — for keyed token hashing in the DB.
# Generate once with: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
INVITATION_HMAC_KEY=

# Refresh token HMAC key — for keyed hashing of refresh tokens stored in the DB.
# Generate once with: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
# WARNING: do not rotate this key without flushing the refresh_tokens table first —
# all live refresh tokens are hashed with this key and will become unresolvable after rotation.
REFRESH_TOKEN_HMAC_KEY=

# Pending-codes HMAC key — for keyed hashing of invitation and pairing codes in
# the pending_codes table. Distinct from INVITATION_HMAC_KEY and
# REFRESH_TOKEN_HMAC_KEY for leak-domain isolation per the cross-device-identity
# brief: a bug in one code surface cannot compromise the others.
# Generate once with: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
# WARNING: rotating this key invalidates every active invitation and pairing code.
HMAC_KEY_PENDING_CODES=

# CORS — comma-separated allowed origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174

# Public URL of the authenticated CORS proxy — surfaced by GET /api/v1/config so
# the client learns the topology instead of hard-coding it. Absolute https URL.
PROXY_PUBLIC_URL=https://proxy.chatsundere.me

# Public URL of the sync service — surfaced by GET /api/v1/config as syncUrl and
# the "sync" feature. Optional absolute https URL (omit to run auth+proxy only).
SYNC_PUBLIC_URL=https://sync.chatsundere.me

# Mirrors the sync-service's S3 blob backend for the /api/v1/config "blobs"
# feature. Set to 'true' ONLY when the sync-service has S3_ENDPOINT configured
# (a manual pairing — see DEPLOYMENT ch.4). Ignored unless SYNC_PUBLIC_URL is set.
SYNC_BLOBS_ENABLED=false
