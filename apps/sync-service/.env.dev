# Sync-service — LOCAL DEVELOPMENT environment.
#
# Throwaway DEV values, deliberately committed. Loopback-bound dev compose only,
# never a deployment. Loaded by the dev scripts via `bun --env-file=.env.dev`.

NODE_ENV=development

# Public sync API port + internal ops port (/healthz, /readyz, /metrics).
# Ops port is 3201 in dev (the example's 9091 is fine too — 3201 keeps it in the
# 3xxx dev range and matches the prometheus scrape target).
PORT=3200
OPS_PORT=3201

LOG_LEVEL=debug

# Postgres — the sync store's own database (dev compose).
DATABASE_URL=postgres://chatsundere:dev@localhost:5432/sync_db
TEST_DATABASE_URL=postgres://chatsundere:dev@localhost:5432/sync_db_test

# Redis — MUST be the same instance/db as auth-service (deny-list visibility).
REDIS_URL=redis://localhost:6379/0

# JWT verification (resource-server). Issuer MUST match the auth-service exactly.
JWT_ISSUER=chatsundere-auth-v1
JWT_AUDIENCE=chatsundere-services
AUTH_JWKS_URL=http://localhost:3100/api/v1/jwks

# CORS — the user-client Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# No front proxy in dev — the client reaches sync directly, so client-IP comes
# straight from the socket (0 trusted hops).
TRUST_PROXY_HOPS=0

# Rate limits (Redis, fail-closed on outage).
RATE_LIMIT_USER_PER_MIN=120
RATE_LIMIT_IP_PER_MIN=600
RATE_LIMIT_DELETE_PER_MIN=60

# Record + account ceilings (quota shared by records + blobs).
MAX_RECORD_BYTES=2097152
ACCOUNT_QUOTA_BYTES=2147483648
MAX_PUSH_RECORDS=100
MAX_BODY_BYTES=25165824

# Blob transport → the dev MinIO. The bucket is auto-created at boot if absent.
# Dev uses the MinIO root credentials directly; production uses a bucket-scoped
# key (see infra/compose.prod.yml.example + DEPLOYMENT ch.7).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chatsundere-blobs
S3_ACCESS_KEY_ID=chatsundere-dev
S3_SECRET_ACCESS_KEY=chatsundere-dev-secret
MAX_BLOB_BYTES=33554432
BLOB_QUOTA_FLOOR_BYTES=65536
BLOB_UPLOAD_IDLE_TIMEOUT_S=30

# Pull paging.
PULL_LIMIT_DEFAULT=200
PULL_LIMIT_MAX=500
PULL_BYTE_BUDGET=8388608

# Doorbell WebSocket.
DOORBELL_TICKET_TTL_S=30
WS_PING_INTERVAL_S=30
WS_IDLE_TIMEOUT_S=255
MAX_SOCKETS_PER_ACCOUNT=8
