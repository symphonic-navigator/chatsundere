# Sync-service environment — zero-knowledge blind-indexed ciphertext store.

NODE_ENV=development

# Public sync API port (Traefik-routed) — serves /api/v1/sync/* only.
PORT=3200
# Internal ops port (NEVER Traefik-routed) — /healthz, /readyz, /metrics.
OPS_PORT=9091

LOG_LEVEL=debug

# Postgres — the sync store's own database.
DATABASE_URL=postgres://chatsundere:dev@localhost:5432/sync_db
# Isolated test database (integration tests refuse to run without it).
TEST_DATABASE_URL=postgres://chatsundere:dev@localhost:5432/sync_db_test

# Redis — rate limits, the revocation deny-list reads, doorbell pub/sub, tickets.
# MUST point at the same Redis instance/db as the auth-service so the deny-list
# keys written by auth are visible here (spec §9).
REDIS_URL=redis://localhost:6379/0

# JWT verification (resource-server role). aud is ignored (variant a), so
# JWT_ISSUER is the only binding claim — it MUST match the auth-service exactly.
JWT_ISSUER=chatsundere-auth-v1
JWT_AUDIENCE=chatsundere-services
AUTH_JWKS_URL=http://localhost:3100/api/v1/jwks

# CORS — conventional (unlike the proxy): exact origins, lowercased.
CORS_ALLOWED_ORIGINS=https://app.chatsundere.me

# Trusted front-proxy hops for client-IP derivation.
TRUST_PROXY_HOPS=1

# Rate limits (Redis, fail-closed on outage).
RATE_LIMIT_USER_PER_MIN=120
RATE_LIMIT_IP_PER_MIN=600
# Separate sliding window for tombstone writes (bounds the destruction primitive).
RATE_LIMIT_DELETE_PER_MIN=60

# Record + account ceilings. The quota is SHARED by records and blobs (§2.3).
MAX_RECORD_BYTES=2097152         # 2 MiB ciphertext per record
ACCOUNT_QUOTA_BYTES=2147483648   # 2 GiB per account (records + blobs)
MAX_PUSH_RECORDS=100             # backstop; clients batch by summed bytes
MAX_BODY_BYTES=25165824          # 24 MiB JSON push body (blob PUTs are exempt, §7.1)

# Blob transport (S3/MinIO). Leave S3_ENDPOINT unset to run records-only; the
# blob endpoints then answer blobs_disabled and the "blobs" feature is absent
# from GET /api/v1/config. Setting S3_ENDPOINT REQUIRES the two credentials.
# S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1                    # MinIO ignores it; AWS needs it
S3_BUCKET=chatsundere-blobs            # created at boot if absent
# S3_ACCESS_KEY_ID=chatsundere-dev     # secret (pino-redacted)
# S3_SECRET_ACCESS_KEY=chatsundere-dev-secret  # secret (pino-redacted)
S3_FORCE_PATH_STYLE=true               # true for MinIO; false for AWS virtual-host style
MAX_BLOB_BYTES=33554432          # 32 MiB ciphertext body per blob
BLOB_QUOTA_FLOOR_BYTES=65536     # 64 KiB accounting floor per blob (§4)
BLOB_UPLOAD_IDLE_TIMEOUT_S=30    # abort a PUT whose body stalls this long (§8)

# Pull paging.
PULL_LIMIT_DEFAULT=200
PULL_LIMIT_MAX=500
PULL_BYTE_BUDGET=8388608         # 8 MiB of encoded records per page

# Doorbell WebSocket.
DOORBELL_TICKET_TTL_S=30
WS_PING_INTERVAL_S=30
# Probe B: Bun 1.3.11 caps idleTimeout at 255 s; liveness relies on the ping loop.
WS_IDLE_TIMEOUT_S=255
MAX_SOCKETS_PER_ACCOUNT=8
