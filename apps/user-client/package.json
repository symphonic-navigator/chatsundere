{
  "name": "@chatsundere/user-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "predev": "pnpm --filter './packages/*' build",
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "generate:icons": "node scripts/generate-placeholder-icons.mjs"
  },
  "dependencies": {
    "@chatsundere/crypto": "workspace:^",
    "@chatsundere/llm-unified": "workspace:^",
    "@chatsundere/shared-types": "workspace:^",
    "@chatsundere/ui-shared": "workspace:^",
    "@tanstack/react-query": "^5.59.0",
    "dexie": "^4.0.0",
    "katex": "^0.16.45",
    "mermaid": "^11.15.0",
    "qr-scanner": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.0.2",
    "uuidv7": "^1.0.2",
    "valibot": "^0.42.0",
    "workbox-window": "^7.3.0",
    "zustand": "^5.0.0"
