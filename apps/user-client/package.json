    "@testing-library/user-event": "^14.5.0",
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^2.1.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "unified": "^11.0.5",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0"
