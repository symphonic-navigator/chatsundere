# Optional: pre-fill this hint in the "Paste invitation URL" form.
# The user-client itself never requires a server to function.
VITE_DEFAULT_BASE_URL=http://localhost:3100

# --- Server-coupled URLs (optional in Block 1 standalone, required in Block 2+) ---
#
# All three are optional at boot. Block 1 is local-only and never reaches
# the server-coupled paths (invitation / pairing / recovery / sync), so the
# user-client renders the intent matrix and chats without these set.
#
# Set them when:
#   * you deploy a backend (auth-service / sync-service / proxy-service) and
#     want users on this client to be able to connect, or
#   * you re-enable the three currently-disabled cells in the onboarding
#     intent matrix (block-2-and-onwards work).
#
# Format: full URL including scheme. Example values point at the dev compose stack.

# VITE_AUTH_URL=http://localhost:3100
# VITE_SYNC_URL=http://localhost:3200

# Operator-specific "request an invitation" page; when set, local-only gate
# tooltips offer it as the invitation path (spec: WS-0 §8).
# VITE_INVITE_REQUEST_URL=https://example.org/request-invite
