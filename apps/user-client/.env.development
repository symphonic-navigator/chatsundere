# User-client — LOCAL DEVELOPMENT overrides, deliberately committed.
#
# Vite loads this file only for the dev server (`pnpm dev`); a production build
# and the test runner never see it. GET /api/v1/config advertises https URLs,
# because the auth-service validator mandates https for them, but the dev
# services listen on plain http. These two overrides (honoured only under
# import.meta.env.DEV, see src/lib/server-urls.ts) point the client at them.
VITE_SYNC_URL=http://localhost:3200
VITE_PROXY_URL=http://localhost:8090
