# Proxy-service — LOCAL DEVELOPMENT environment.
#
# Throwaway DEV values, deliberately committed. Loopback-bound dev compose only,
# never a deployment. Loaded by the dev scripts via `bun --env-file=.env.dev`.
# The proxy is stateless but for Redis rate-limit counters.

NODE_ENV=development

# Public forward-proxy port + internal ops port (/healthz, /readyz, /metrics).
# Public is 8090 in dev — 8080 is commonly occupied on a dev box (e.g. a system
# service). Ops is 3300 — the example's 9090 collides with the dev Prometheus
# host port, and 3300 is what prometheus.yml already scrapes for the proxy.
PORT=8090
OPS_PORT=3300

LOG_LEVEL=debug

# Redis — dedicated db 2 for the transient rate-limit counters.
REDIS_URL=redis://localhost:6379/2

# JWT verification (resource-server). Issuer MUST match the auth-service exactly.
JWT_ISSUER=chatsundere-auth-v1
JWT_AUDIENCE=chatsundere-services
AUTH_JWKS_URL=http://localhost:3100/api/v1/jwks

# CORS — the user-client Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# No front proxy in dev — client-IP comes straight from the socket.
TRUST_PROXY_HOPS=0

# Rate limits (Redis, fail-closed on outage).
RATE_LIMIT_USER_PER_MIN=120
RATE_LIMIT_IP_PER_MIN=600

# Streamed request-body cap (50 MiB — generous for Vision base64 images).
MAX_BODY_BYTES=52428800

# Per-user concurrent-connection cap.
MAX_CONCURRENT_PER_USER=6

# Bun idleTimeout (seconds) — long legitimate streams survive.
PROXY_IDLE_TIMEOUT_S=120
