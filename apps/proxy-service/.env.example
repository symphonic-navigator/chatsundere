# Proxy-service environment — authenticated CORS forward proxy.
# The proxy is stateless but for Redis (rate-limit counters); it never touches
# Postgres and never writes request data anywhere.

NODE_ENV=development

# Public forward-proxy port (Traefik-routed). No reserved paths — every path is
# proxied, so an upstream path like /metrics or /healthz is reachable.
PORT=8080
# Internal ops port (NEVER Traefik-routed) — /healthz, /readyz, /metrics live here.
OPS_PORT=9090

LOG_LEVEL=debug

# Redis — transient rate-limit counters (TTL). The jose JWKS set is cached
# in-process, not in Redis.
REDIS_URL=redis://localhost:6379/2

# JWT verification (resource-server role). aud is declared but ignored (variant a),
# so JWT_ISSUER is the only claim binding a token to this domain — it MUST match
# the auth-service issuer exactly.
JWT_ISSUER=chatsundere-auth-v1
JWT_AUDIENCE=chatsundere-services
AUTH_JWKS_URL=http://localhost:3100/api/v1/jwks

# CORS — comma-separated exact origins (scheme+host+port, lowercased). Browser-only
# defence-in-depth, never an auth layer.
CORS_ALLOWED_ORIGINS=https://app.chatsundere.me

# Trusted front-proxy boundary for client-IP derivation. Number of hops from the
# right of X-Forwarded-For that the trusted front proxy (Traefik) observed.
TRUST_PROXY_HOPS=1

# Rate limits (Redis, fail-closed on outage).
RATE_LIMIT_USER_PER_MIN=120
RATE_LIMIT_IP_PER_MIN=600

# Max request-body size enforced on the streamed bytes (not just Content-Length).
# 50 MiB — generous for Vision base64 images, but bounded (413 over cap).
MAX_BODY_BYTES=52428800

# Per-user concurrent-connection cap (in-process; valid for a single replica).
MAX_CONCURRENT_PER_USER=6

# Bun idleTimeout (seconds) — inactivity-aimed so long legitimate streams survive.
PROXY_IDLE_TIMEOUT_S=120
