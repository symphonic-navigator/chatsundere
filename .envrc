# Root .envrc — keep only repo-wide concerns.
#
# Per-app .env files (apps/<app>/.env) are loaded by each runtime itself when
# it boots in that directory: Vite for the frontends (user-client, admin-client)
# and Bun for the backends (auth-service, sync-service, proxy-service). Both
# auto-load .env from cwd.
#
# Loading all five apps' .env files into a single shell here caused
# DATABASE_URL / PORT collisions because later entries overwrote earlier ones
# (the proxy-service .env's DATABASE_URL silently took precedence over the
# auth-service .env's DATABASE_URL). The fix is to stop loading them globally
# and let each service pick up its own .env when pnpm filter cds into the
# package directory before running.
#
# If you need a particular env var visible in the parent shell (e.g. for a
# repo-wide script that reads it), set it explicitly here or export it from
# the calling shell.
PATH_add node_modules/.bin

if git rev-parse --is-inside-work-tree &>/dev/null; then
  # Refresh the remote-tracking ref in the background so the ahead/behind check
  # below reflects reality. @{u} is only as fresh as the last fetch, so without
  # this a remote that advanced would never be detected. Fully detached in a
  # subshell (no network wait blocking the prompt); its result lands for the
  # *next* directory entry, which is the standard direnv pattern.
  ( git fetch --quiet >/dev/null 2>&1 & )

  if git rev-parse @{u} &>/dev/null; then
    LOCAL=$(git rev-parse @)
    REMOTE=$(git rev-parse @{u})
    BASE=$(git merge-base @ @{u})
    if [ "$LOCAL" = "$REMOTE" ]; then
      : # up to date
    elif [ "$LOCAL" = "$BASE" ]; then
      echo "⚠️  Remote is ahead – maybe git pull?"
    elif [ "$REMOTE" = "$BASE" ]; then
      echo "ℹ️  Local is ahead – you have unpushed commits."
    else
      echo "⚠️  Branches have diverged – pull/rebase before pushing."
    fi
  fi
fi

# Warn (do not auto-install) when the lockfile is newer than the installed
# modules, i.e. a pull/branch-switch changed dependencies. pnpm rewrites
# node_modules/.modules.yaml on every install, so it is the install marker.
if [ -f pnpm-lock.yaml ]; then
  if [ ! -d node_modules ] || [ pnpm-lock.yaml -nt node_modules/.modules.yaml ]; then
    echo "⚠️  pnpm-lock.yaml changed – run pnpm install."
  fi
fi
