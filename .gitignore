obsidian/.obsidian/workspace*
obsidian/.obsidian/workspace-mobile.json
obsidian/.obsidian/cache
obsidian/.obsidian/types.json
obsidian/.trash/

# direnv local overrides
.envrc.local

# Editor / OS clutter
.DS_Store
.idea/
.vscode/
*.swp

# API keys
keys/

# Chatsundere — added by project-structure unit

# Docker bind-mount target (local dev data, never committed)
infra/data/

# Per-service env files (.env at root is already gitignored)
apps/*/.env
packages/*/.env

# Production compose file (only the .example is committed)
infra/compose.prod.yml

# Turborepo local cache (regenerated per build, never committed)
.turbo/
.superpowers/

# Data exchange / analysis artefacts
analysis/
screenshots/

# Visual examples
visuals/

# Dev-only IndexedDB dumps written by the user-client's DevDumpButton —
# Claude / debug sessions only, never committed.
dumps/

# === Claude Code (transient session state) ===
.claude/scheduled_tasks.lock
.claude/worktrees/
